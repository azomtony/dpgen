{
  "api_version": "1.0",
  "deepmd_version": "2.2.0",
  "train": {
    "command": "dp",
    "machine": {
      "batch_type": "Slurm",
      "context_type": "LocalContext",
      "local_root": "./"
    },
    "resources": {
      "number_node": 1,
      "cpu_per_node": 0,
      "gpu_per_node": 0,
      "queue_name": "GPU_QUEUE",
      "custom_flags": [
        "#SBATCH --gres=gpu:1",
        "#SBATCH --time=24:00:00"
      ],
      "group_size": 1,
      "source_list": [
        "source /path/to/deepmd/env/activate"
      ]
    }
  }
}
