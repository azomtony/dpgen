{
  "type_map": ["Cu", "O"],
  "mass_map": [63.546, 15.999],
  "init_data_prefix": "initial_data",
  "init_data_sys": [
    "cu/deepmd",
    "cuo/deepmd"
  ],
  "sys_configs_prefix": "generated/sys_configs",
  "sys_configs_globs": [
    ["cu_fcc/**/*.POSCAR", "cu_fcc/**/POSCAR"],
    ["cuo_bulk/**/*.POSCAR", "cuo_bulk/**/POSCAR"]
  ],
  "fp_pp_path": "pseudopotentials",
  "fp_pp_files": ["POTCAR_Cu", "POTCAR_O"],
  "fp_incar": {
    "0": "templates/INCAR.cu-metal",
    "1": "templates/INCAR.oxide",
    "default": "templates/INCAR.static"
  },
  "fp_kpoints": {
    "0": {
      "style": "Monkhorst-Pack",
      "mesh": [2, 2, 1],
      "shift": [0, 0, 0]
    },
    "1": {
      "style": "Monkhorst-Pack",
      "mesh": [2, 1, 2],
      "shift": [0, 0, 0]
    }
  },
  "numb_models": 4,
  "train_backend": "pytorch",
  "training_stop_batch": 200000,
  "model_devi_jobs": [
    {
      "_idx": "00",
      "sys_idx": [0, 1],
      "temps": [300, 600, 900],
      "press": [1.0],
      "trj_freq": 10,
      "nsteps": 1000,
      "ensemble": "npt"
    },
    {
      "_idx": "01",
      "sys_idx": [0, 1],
      "temps": [300, 600, 900, 1200],
      "press": [1.0, 10000.0],
      "trj_freq": 10,
      "nsteps": 3000,
      "ensemble": "npt"
    }
  ],
  "model_devi_f_trust_lo": 0.08,
  "model_devi_f_trust_hi": 0.25,
  "fp_task_max": 50,
  "fp_task_min": 5
}
